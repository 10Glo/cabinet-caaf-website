# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string used by Payload
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/cabinet-caaf-website

# Used to sign auth tokens/cookies. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public origin of the site, used for CORS/CSRF allow-lists
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Credentials for the local docker-compose postgres service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cabinet-caaf-website
